{
  "name": "trivattle-catalogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline Wikipedia card and validated trivia catalogue",
  "scripts": {
    "build": "tsc && mkdir -p dist/config && cp config/*.json dist/config/",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "cards": "tsx src/cli.ts",
    "simulate": "tsx scripts/simulate.ts",
    "fixtures": "tsx scripts/fixtures.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "types": "./dist/src/index.d.ts"
}
