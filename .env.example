# Copy to .env. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
WIKIMEDIA_USER_AGENT="Trivattle/0.1 (mailto:your-real-contact@example.org)"
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Explicitly disable default high-effort thinking for lower latency.
# enabled restores thinking; auto leaves the provider default unchanged.
DEEPSEEK_THINKING=disabled
# Optional bounded decision model; no key uses rules-v1.
JEV_API_KEY=
JEV_MODEL=jev-latest
CARD_CATALOGUE=data/catalogue
# CARD_CONFIG=/absolute/path/gameplay.json
# TYPE_CONFIG=/absolute/path/effectiveness.json

# Online game (Node 24). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Browser-facing origin: use http://localhost:5173 for npm run dev,
# http://localhost:3001 for npm start, or your HTTPS production origin.
BETTER_AUTH_URL=http://localhost:5173
PLAYER_DB=data/player/player.sqlite
CARD_DATA_DIR=data/catalogue
HOST=127.0.0.1
PORT=3001
STARTER_PACKS=3
PACK_WEIGHTS=[55,28,12,4,1]
PACK_EMPTY_POOL=reject
RECONNECT_MS=120000
LOBBY_IDLE_MS=1800000
BATTLE_IDLE_MS=7200000
# Optional local hot-seat sandbox, always disabled under NODE_ENV=production.
LOCAL_BATTLE_LAB=false

# Shared Wikimedia artwork cache (not served as a static directory)
IMAGE_CACHE_DIR=data/art-cache
