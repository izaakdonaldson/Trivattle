# Copy to .env. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
WIKIMEDIA_USER_AGENT="Trivattle/0.1 (mailto:your-real-contact@example.org)"
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional bounded decision model; no key uses rules-v1.
JEV_API_KEY=
JEV_MODEL=jev-latest
CARD_CATALOGUE=data/catalogue
